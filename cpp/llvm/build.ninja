# Utility command for install-clang-tidy-headers-stripped

build tools/clang/tools/extra/clang-tidy/install-clang-tidy-headers-stripped: phony tools/clang/tools/extra/clang-tidy/CMakeFiles/install-clang-tidy-headers-stripped tools/clang/tools/extra/clang-tidy/clang-tidy-headers


#############################################
# Utility command for package

build tools/clang/tools/extra/clang-tidy/CMakeFiles/package.util: CUSTOM_COMMAND tools/clang/tools/extra/clang-tidy/all
  COMMAND = cd /home/luca/learnhardcode/cpp/emception/build/llvm && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build tools/clang/tools/extra/clang-tidy/package: phony tools/clang/tools/extra/clang-tidy/CMakeFiles/package.util


