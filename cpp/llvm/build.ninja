build tools/llvm-reduce/CMakeFiles/package.util: CUSTOM_COMMAND tools/llvm-reduce/all
  COMMAND = cd /home/luca/learnhardcode/cpp/emception/build/llvm && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build tools/llvm-reduce/package: phony tools/llvm-reduce/CMakeFiles/package.util

# =============================================================================
# Object build statements for EXECUTABLE target llvm-reduce


#############################################
