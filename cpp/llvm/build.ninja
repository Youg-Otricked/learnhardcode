build lib/Demangle/CMakeFiles/LLVMDemangle.dir/Demangle.cpp.o: CXX_COMPILER__LLVMDemangle /home/luca/learnhardcode/cpp/emception/upstream/llvm-project/llvm/lib/Demangle/Demangle.cpp || cmake_object_order_depends_target_LLVMDemangle
  DEFINES = -DGTEST_HAS_RTTI=0 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
