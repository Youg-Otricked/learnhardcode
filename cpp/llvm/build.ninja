build bin/llvm-locstats: CUSTOM_COMMAND /home/luca/learnhardcode/cpp/emception/upstream/llvm-project/llvm/utils/llvm-locstats/llvm-locstats.py bin/llvm-dwarfdump.mjs || bin/llvm-dwarfdump.mjs include/llvm/IR/intrinsics_gen include/llvm/Support/llvm_vcsrevision_h lib/Support/BLAKE3/LLVMSupportBlake3 lib/Target/WebAssembly/WebAssemblyCommonTableGen lib/libLLVMAggressiveInstCombine.a lib/libLLVMAnalysis.a lib/libLLVMAsmParser.a lib/libLLVMBinaryFormat.a lib/libLLVMBitReader.a lib/libLLVMBitWriter.a lib/libLLVMBitstreamReader.a lib/libLLVMCodeGen.a lib/libLLVMCore.a lib/libLLVMDebugInfoCodeView.a lib/libLLVMDebugInfoDWARF.a lib/libLLVMDebugInfoMSF.a lib/libLLVMDebugInfoPDB.a lib/libLLVMDemangle.a lib/libLLVMIRReader.a lib/libLLVMInstCombine.a lib/libLLVMMC.a lib/libLLVMMCParser.a lib/libLLVMObjCARCOpts.a lib/libLLVMObject.a lib/libLLVMProfileData.a lib/libLLVMRemarks.a lib/libLLVMScalarOpts.a lib/libLLVMSupport.a lib/libLLVMSymbolize.a lib/libLLVMTarget.a lib/libLLVMTextAPI.a lib/libLLVMTransformUtils.a lib/libLLVMWebAssemblyDesc.a lib/libLLVMWebAssemblyInfo.a lib/libLLVMWebAssemblyUtils.a
  COMMAND = cd /home/luca/learnhardcode/cpp/emception/build/llvm/utils/llvm-locstats && /usr/bin/cmake -E copy /home/luca/learnhardcode/cpp/emception/upstream/llvm-project/llvm/utils/llvm-locstats/llvm-locstats.py /home/luca/learnhardcode/cpp/emception/build/llvm/./bin/llvm-locstats
  DESC = Copying llvm-locstats into /home/luca/learnhardcode/cpp/emception/build/llvm/./bin
  restat = 1

