build tools/clang/tools/apinotes-test/CMakeFiles/apinotes-test.dir/APINotesTest.cpp.o: CXX_COMPILER__apinotes-test /home/luca/learnhardcode/cpp/emception/upstream/llvm-project/clang/tools/apinotes-test/APINotesTest.cpp || cmake_object_order_depends_target_apinotes-test
  DEFINES = -DGTEST_HAS_RTTI=0 -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE -D_LARGEFILE_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
