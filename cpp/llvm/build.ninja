  COMMAND = cd /home/luca/learnhardcode/cpp/emception/build/llvm && /usr/bin/cpack --config ./CPackSourceConfig.cmake /home/luca/learnhardcode/cpp/emception/build/llvm/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build tools/clang/package_source: phony tools/clang/CMakeFiles/package_source.util


