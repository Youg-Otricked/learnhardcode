b/libLLVMSymbolize.a lib/libLLVMTextAPI.a lib/libLLVMTransformUtils.a lib/libLLVMWindowsDriver.a lib/libclangAST.a lib/libclangASTMatchers.a lib/libclangAnalysis.a lib/libclangBasic.a lib/libclangDriver.a lib/libclangEdit.a lib/libclangFormat.a lib/libclangFrontend.a lib/libclangLex.a lib/libclangParse.a lib/libclangRewrite.a lib/libclangSema.a lib/libclangSerialization.a lib/libclangSupport.a lib/libclangToolingCore.a lib/libclangToolingInclusions.a tools/clang/clang-tablegen-targets tools/clang/include/clang/Driver/ClangDriverOptions tools/clang/lib/Tooling/obj.clangTooling
  LANGUAGE_COMPILE_FLAGS = -Dwait4=__syscall_wait4 -fPIC -fvisibility-inlines-hidden -Werror=date-time -Werror=unguarded-availability-new -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wmissing-field-initializers -pedantic -Wno-long-long -Wc++98-compat-extra-semi -Wimplicit-fallthrough -Wcovered-switch-default -Wno-noexcept-type -Wnon-virtual-dtor -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wstring-conversion -Wmisleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -Wno-nested-anon-types -O3 -DNDEBUG
  OBJECT_DIR = tools/clang/lib/Tooling/CMakeFiles/clangTooling.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = lib/libclangTooling.a
  TARGET_PDB = clangTooling.a.dbg


#############################################
# Utility command for install/local

build tools/clang/lib/Tooling/CMakeFiles/install/local.util: CUSTOM_COMMAND tools/clang/lib/Tooling/all
  COMMAND = cd /home/luca/learnhardcode/cpp/emception/build/llvm/tools/clang/lib/Tooling && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build tools/clang/lib/Tooling/install/local: phony tools/clang/lib/Tooling/CMakeFiles/install/local.util

