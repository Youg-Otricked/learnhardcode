write cmake_object_order_depends_target_clangSema cmake_object_order_depends_target_clangSerialization cmake_object_order_depends_target_clangSupport cmake_object_order_depends_target_clangTooling cmake_object_order_depends_target_clangToolingCore cmake_object_order_depends_target_clangToolingInclusions cmake_object_order_depends_target_findAllSymbols tools/clang/clang-tablegen-targets tools/clang/lib/Headers/clang-resource-headers

build tools/clang/tools/extra/clang-include-fixer/tool/CMakeFiles/clang-include-fixer.dir/ClangIncludeFixer.cpp.o: CXX_COMPILER__clang-include-fixer /home/luca/learnhardcode/cpp/emception/upstream/llvm-project/clang-tools-extra/clang-include-fixer/tool/ClangIncludeFixer.cpp || cmake_object_order_depends_target_clang-include-fixer
  DEFINES = -DGTEST_HAS_RTTI=0 -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE -D_LARGEFILE_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/tools/extra/clang-include-fixer/tool/CMakeFiles/clang-include-fixer.dir/ClangIncludeFixer.cpp.o.d
  FLAGS = -Dwait4=__syscall_wait4 -fPIC -fvisibility-inlines-hidden -Werror=date-time -Werror=unguarded-availability-new -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wmissing-field-initializers -pedantic -Wno-long-long -Wc++98-compat-extra-semi -Wimplicit-fallthrough -Wcovered-switch-default -Wno-noexcept-type -Wnon-virtual-dtor -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wstring-conversion -Wmisleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -Wno-nested-anon-types -O3 -DNDEBUG    -fno-exceptions -fno-rtti -std=c++17
  INCLUDES = -Itools/clang/tools/extra/clang-include-fixer/tool -I/home/luca/learnhardcode/cpp/emception/upstream/llvm-project/clang-tools-extra/clang-include-fixer/tool -I/home/luca/learnhardcode/cpp/emception/upstream/llvm-project/clang/include -Itools/clang/include -Iinclude -I/home/luca/learnhardcode/cpp/emception/upstream/llvm-project/llvm/include -I/home/luca/learnhardcode/cpp/emception/upstream/llvm-project/clang-tools-extra/clang-include-fixer/tool/..
  OBJECT_DIR = tools/clang/tools/extra/clang-include-fixer/tool/CMakeFiles/clang-include-fixer.dir
  OBJECT_FILE_DIR = tools/clang/tools/extra/clang-include-fixer/tool/CMakeFiles/clang-include-fixer.dir


