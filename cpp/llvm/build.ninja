t_order_depends_target_clangRewrite cmake_object_order_depends_target_clangSema cmake_object_order_depends_target_clangSerialization cmake_object_order_depends_target_clangStaticAnalyzerCheckers cmake_object_order_depends_target_clangStaticAnalyzerCore cmake_object_order_depends_target_clangStaticAnalyzerFrontend cmake_object_order_depends_target_clangSupport cmake_object_order_depends_target_clangTooling cmake_object_order_depends_target_clangToolingCore cmake_object_order_depends_target_clangToolingInclusions cmake_object_order_depends_target_obj.clangTidy include/llvm/Frontend/OpenMP/omp_gen tools/clang/clang-tablegen-targets tools/clang/include/clang/StaticAnalyzer/Checkers/ClangSACheckers


# =============================================================================
# Link build statements for STATIC_LIBRARY target clangTidy


#############################################
# Link the static library lib/libclangTidy.a

build lib/libclangTidy.a: CXX_STATIC_LIBRARY_LINKER__clangTidy tools/clang/tools/extra/clang-tidy/CMakeFiles/obj.clangTidy.dir/ClangTidy.cpp.o tools/clang/tools/extra/clang-tidy/CMakeFiles/obj.clangTidy.dir/ClangTidyCheck.cpp.o tools/clang/tools/extra/clang-tidy/CMakeFiles/obj.clangTidy.dir/ClangTidyModule.cpp.o tools/clang/tools/extra/clang-tidy/CMakeFiles/obj.clangTidy.dir/ClangTidyDiagnosticConsumer.cpp.o tools/clang/tools/extra/clang-tidy/CMakeFiles/obj.clangTidy.dir/ClangTidyOptions.cpp.o tools/clang/tools/extra/clang-tidy/CMakeFiles/obj.clangTidy.dir/ClangTidyProfiling.cpp.o tools/clang/tools/extra/clang-tidy/CMakeFiles/obj.clangTidy.dir/ExpandModularHeadersPPCallbacks.cpp.o tools/clang/tools/extra/clang-tidy/CMakeFiles/obj.clangTidy.dir/GlobList.cpp.o tools/clang/tools/extra/clang-tidy/CMakeFiles/obj.clangTidy.dir/NoLintDirectiveHandler.cpp.o || include/llvm/Frontend/OpenMP/omp_gen lib/libLLVMAggressiveInstCombine.a lib/libLLVMAnalysis.a lib/libLLVMAsmParser.a lib/libLLVMBinaryFormat.a lib/libLLVMBitReader.a lib/libLLVMBitstreamReader.a lib/libLLVMCore.a lib/libLLVMDebugInfoCodeView.a lib/libLLVMDebugInfoDWARF.a lib/libLLVMDebugInfoMSF.a lib/libLLVMDebugInfoPDB.a lib/libLLVMDemangle.a lib/libLLVMFrontendHLSL.a lib/libLLVMFrontendOpenMP.a lib/libLLVMIRReader.a lib/libLLVMInstCombine.a lib/libLLVMMC.a lib/libLLVMMCParser.a lib/libLLVMObject.a lib/libLLVMOption.a lib/libLLVMProfileData.a lib/libLLVMRemarks.a lib/libLLVMScalarOpts.a lib/libLLVMSupport.a lib/libLLVMSymbolize.a lib/libLLVMTextAPI.a lib/libLLVMTransformUtils.a lib/libLLVMWindowsDriver.a lib/libclangAST.a lib/libclangASTMatchers.a lib/libclangAnalysis.a lib/libclangBasic.a lib/libclangCrossTU.a lib/libclangDriver.a lib/libclangEdit.a lib/libclangFormat.a lib/libclangFrontend.a lib/libclangIndex.a lib/libclangLex.a lib/libclangParse.a lib/libclangRewrite.a lib/libclangSema.a lib/libclangSerialization.a lib/libclangStaticAnalyzerCheckers.a lib/libclangStaticAnalyzerCore.a lib/libclangStaticAnalyzerFrontend.a lib/libclangSupport.a lib/libclangTooling.a lib/libclangToolingCore.a lib/libclangToolingInclusions.a tools/clang/clang-tablegen-targets tools/clang/include/clang/StaticAnalyzer/Checkers/ClangSACheckers tools/clang/tools/extra/clang-tidy/obj.clangTidy
  LANGUAGE_COMPILE_FLAGS = -Dwait4=__syscall_wait4 -fPIC -fvisibility-inlines-hidden -Werror=date-time -Werror=unguarded-availability-new -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wmissing-field-initializers -pedantic -Wno-long-long -Wc++98-compat-extra-semi -Wimplicit-fallthrough -Wcovered-switch-default -Wno-noexcept-type -Wnon-virtual-dtor -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wstring-conversion -Wmisleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -Wno-nested-anon-types -O3 -DNDEBUG
  OBJECT_DIR = tools/clang/tools/extra/clang-tidy/CMakeFiles/clangTidy.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = lib/libclangTidy.a
  TARGET_PDB = clangTidy.a.dbg


