  LINK_LIBRARIES = lib/libLLVMSupport.a  lib/libclangPseudoGrammar.a  lib/libLLVMSupport.a  -lrt  -lm  lib/libLLVMDemangle.a
  OBJECT_DIR = tools/clang/tools/extra/pseudo/gen/CMakeFiles/clang-pseudo-gen.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = bin/clang-pseudo-gen.mjs
  TARGET_PDB = clang-pseudo-gen.mjs.dbg

