#############################################
# Rule for compiling CXX files.

rule CXX_COMPILER__Bye
  depfile = $DEP_FILE
  deps = gcc
  command = /emsdk/upstream/emscripten/em++  $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE -o $out -c $in
  description = Building CXX object $out


#############################################
# Rule for linking CXX static library.

rule CXX_STATIC_LIBRARY_LINKER__Bye
  command = $PRE_LINK && /usr/bin/cmake -E remove $TARGET_FILE && /emsdk/upstream/emscripten/emar qc $TARGET_FILE $LINK_FLAGS $in && /emsdk/upstream/emscripten/emranlib $TARGET_FILE && $POST_BUILD
  description = Linking CXX static library $TARGET_FILE
  restat = $RESTAT


