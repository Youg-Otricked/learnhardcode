  command = $PRE_LINK && /usr/bin/cmake -E remove $TARGET_FILE && /emsdk/upstream/emscripten/emar qc $TARGET_FILE $LINK_FLAGS $in && /emsdk/upstream/emscripten/emranlib $TARGET_FILE && $POST_BUILD
  description = Linking CXX static library $TARGET_FILE
  restat = $RESTAT


