build bin/binaryen-box.mjs: CXX_EXECUTABLE_LINKER__wasm-as binaryen-box.cpp.o src/tools/CMakeFiles/wasm-as.dir/wasm-as_binaryen-box.cpp.o src/tools/CMakeFiles/wasm-ctor-eval.dir/wasm-ctor-eval_binaryen-box.cpp.o src/tools/CMakeFiles/wasm-emscripten-finalize.dir/wasm-emscripten-finalize_binaryen-box.cpp.o src/tools/CMakeFiles/wasm-metadce.dir/wasm-metadce_binaryen-box.cpp.o src/tools/CMakeFiles/wasm-opt.dir/fuzzing/fuzzing_binaryen-box.cpp.o src/tools/CMakeFiles/wasm-opt.dir/fuzzing/heap-types_binaryen-box.cpp.o src/tools/CMakeFiles/wasm-opt.dir/fuzzing/random_binaryen-box.cpp.o src/tools/CMakeFiles/wasm-opt.dir/wasm-opt_binaryen-box.cpp.o src/tools/CMakeFiles/wasm-shell.dir/wasm-shell_binaryen-box.cpp.o | lib/libbinaryen.a || lib/libbinaryen.a
  FLAGS =  -DNDEBUG -O2 -O3 -UNDEBUG -Wall -Werror -Wextra -Wimplicit-fallthrough -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-parameter -Wnon-virtual-dtor -Wswitch -fcolor-diagnostics -fno-omit-frame-pointer -fno-rtti -sDISABLE_EXCEPTION_CATCHING=0 
  LINK_FLAGS =  --js-library=/home/luca/learnhardcode/cpp/emception/emlib/fsroot.js -O3 -lproxyfs.js -sALLOW_MEMORY_GROWTH -sDISABLE_EXCEPTION_CATCHING=0 -s ALLOW_MEMORY_GROWTH=1 -s EXPORTED_FUNCTIONS=_main,_free,_malloc -s EXPORTED_RUNTIME_METHODS=FS,PROXYFS,ERRNO_CODES,allocateUTF8 
  LINK_LIBRARIES =  lib/libbinaryen.a 
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = bin/binaryen-box.mjs

build binaryen-box: phony bin/binaryen-box.mjs

