'./system/lib/libc/musl/src/fcntl/open.c¤ƒØˆ’šØˆ’š#include <fcntl.h>
#include <stdarg.h>
#include "syscall.h"

int open(const char *filename, int flags, ...)
{
	mode_t mode = 0;

	if ((flags & O_CREAT) || (flags & O_TMPFILE) == O_TMPFILE) {
		va_list ap;
		va_start(ap, flags);
		mode = va_arg(ap, mode_t);
		va_end(ap);
	}

	int fd = __sys_open_cp(filename, flags, mode);
#ifndef __EMSCRIPTEN__ // CLOEXEC makes no sense for a single process
	if (fd>=0 && (flags & O_CLOEXEC))
		__syscall(SYS_fcntl, fd, F_SETFD, FD_CLOEXEC);
#endif

	return __syscall_ret(fd);
}

weak_alias(open, open64);
"./system/lib/libc/musl/src/complexíƒ£ÖÏØˆ’š␀+./system/lib/libc/musl/src/complex/catanh.c¤ƒØˆ’šØˆ’š¯#include "complex_impl.h"

/* atanh = -i atan(i z) */

double complex catanh(double complex z)
{
	z = catan(CMPLX(-cimag(z), creal(z)));
	return CMPLX(cimag(z), -creal(z));
}
