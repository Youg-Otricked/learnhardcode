  func(ctx);
}

!./system/lib/libc/compat/strlwr.c¤ƒØˆ’šØˆ’šƒ#include <ctype.h>

char *strlwr(char *str)
{
	char *ret = str;
	while(*str)
	{
		*str = tolower(*str);
		++str;
	}
	return ret;
}
!./system/lib/libc/compat/strupr.c¤ƒØˆ’šØˆ’šƒ#include <ctype.h>

char *strupr(char *str)
{
	char *ret = str;
	while(*str)
	{
		*str = toupper(*str);
		++str;
	}
	return ret;
}
