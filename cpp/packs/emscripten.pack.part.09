1./system/lib/libc/musl/src/internal/syscall_ret.c¤ƒØˆ’šØˆ’šŽ#include <errno.h>
#include "syscall.h"

long __syscall_ret(unsigned long r)
{
	if (r > -4096UL) {
		errno = -r;
		return -1;
	}
	return r;
}
