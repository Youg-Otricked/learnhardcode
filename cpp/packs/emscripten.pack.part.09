  template<class _Range>
  drop_view(_Range&&, range_difference_t<_Range>) -> drop_view<views::all_t<_Range>>;

  template<class _Tp>
  inline constexpr bool enable_borrowed_range<drop_view<_Tp>> = enable_borrowed_range<_Tp>;
} // namespace ranges

