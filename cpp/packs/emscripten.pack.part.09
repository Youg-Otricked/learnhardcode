int dup2(int old, int new)
{
	int r;
#ifdef SYS_dup2
	while ((r=__syscall(SYS_dup2, old, new))==-EBUSY);
#else
	if (old==new) {
#ifdef __EMSCRIPTEN__
		r = __wasi_fd_is_valid(old) ? 0 : -EBADF;
