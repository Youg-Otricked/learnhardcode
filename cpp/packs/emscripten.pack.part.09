#ifdef __EMSCRIPTEN__
// In emscripten, avoid iostream to avoid using WasmFS code during logging.
#include <emscripten/console.h>
#else
#include <iostream>
#endif

#include "support.h"

namespace wasmfs {

void handle_unreachable(const char* msg, const char* file, unsigned line) {
#ifndef NDEBUG
#ifdef __EMSCRIPTEN__
  if (msg) {
    emscripten_console_error(msg);
  }
  emscripten_console_error("UNREACHABLE executed");
  if (file) {
    emscripten_console_errorf("at %s:%d", file, line);
  }
#else // EMSCRIPTEN
  if (msg) {
    std::cerr << msg << "\n";
  }
  std::cerr << "UNREACHABLE executed";
  if (file) {
    std::cerr << " at " << file << ":" << line;
  }
  std::cerr << "!\n";
#endif
  // TODO: sanitizer integration, see binaryen's similar code
#endif
  __builtin_trap();
}

} // namespace wasmfs
