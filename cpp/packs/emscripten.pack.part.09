#endif
			f = __fdopen(fd, "w+");
#ifdef __EMSCRIPTEN__
			if (!f) __wasi_fd_close(fd);
#else
			if (!f) __syscall(SYS_close, fd);
#endif
			return f;
		}
	}
	return 0;
}

