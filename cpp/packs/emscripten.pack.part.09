#define ROUND2 119
#define NX 5
#define NY 3
static const long double
pio4    =  0x1.921fb54442d18469898cc51701b8p-1L,
invpio2 =  6.3661977236758134307553505349005747e-01L,	/*  0x145f306dc9c882a53f84eafa3ea6a.0p-113 */
