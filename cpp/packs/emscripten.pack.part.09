1./system/lib/libc/musl/src/math/__math_invalidf.c¤ƒØˆ’šØˆ’šQ#include "libm.h"

float __math_invalidf(float x)
{
	return (x - x) / (x - x);
}
/./system/lib/libc/musl/src/math/__fpclassifyf.c¤ƒØˆ’šØˆ’šþ#include <math.h>
#include <stdint.h>

int __fpclassifyf(float x)
{
	union {float f; uint32_t i;} u = {x};
	int e = u.i>>23 & 0xff;
	if (!e) return u.i<<1 ? FP_SUBNORMAL : FP_ZERO;
	if (e==0xff) return u.i<<9 ? FP_NAN : FP_INFINITE;
	return FP_NORMAL;
}
'./system/lib/libc/musl/src/math/fminf.c¤ƒØˆ’šØˆ’šæ#include <math.h>

float fminf(float x, float y)
{
	if (isnan(x))
		return y;
	if (isnan(y))
		return x;
// XXX EMSCRIPTEN: use wasm builtins for code size
#ifdef __wasm__
	return __builtin_wasm_min_f32(x, y);
#else
	/* handle signed zeros, see C99 Annex F.9.9.2 */
	if (signbit(x) != signbit(y))
		return signbit(x) ? x : y;
	return x < y ? x : y;
#endif
}
