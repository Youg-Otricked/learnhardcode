typedef struct ap_control {
  char apc_label[16];
  char apc_config[16];
  unsigned char apc_p;
  unsigned long apc_cmd;
  unsigned long apc_arg;
  void *apc_data;
  size_t apc_dsize;
} ap_ctl_t;

typedef struct ipftq {
  ipfmutex_t ifq_lock;
  unsigned int ifq_ttl;
  void *ifq_head;
  void **ifq_tail;
  void *ifq_next;
  void **ifq_pnext;
  int ifq_ref;
  unsigned int ifq_flags;
} ipftq_t;

typedef struct ipfobj {
  uint32_t ipfo_rev;
  uint32_t ipfo_size;
  void *ipfo_ptr;
  int ipfo_type;
  int ipfo_offset;
  int ipfo_retval;
  unsigned char ipfo_xxxpad[28];
} ipfobj_t;

